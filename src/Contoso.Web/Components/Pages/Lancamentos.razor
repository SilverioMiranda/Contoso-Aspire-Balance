@page "/lancamentos"
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

@inject TransactionsApiClient TransactionsApiClient
@inject NavigationManager NavigationManager
@inject TimeProvider TimeProvider

<PageTitle>Lançamentos</PageTitle>

<h1>Lançamentos do dia</h1>

<p>Esta página consome a API de lançamentos para exibir os registros do dia atual.</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Data de criação</th>
            <th>Descrição</th>
            <th>Valor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var transaction in transactions)
        {
            <tr>
                <td>@transaction.Id</td>
                <td>@transaction.CreatedAt</td>
                <td>@transaction.Description</td>
                <td>@transaction.Value</td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
            </button>
        </li>
        @for (var i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(currentPage == i ? "active" : "")">
                <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
            </li>
        }
        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" aria-label="Next">
                <span aria-hidden="true">&raquo;</span>
            </button>
        </li>
    </ul>
</nav>

@code {
    private IReadOnlyList<TransactionsApiClient.Transaction> transactions = [];

    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    private const int PageSize = 10;
    private int totalPages = 1;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (currentPage < 1)
        {
            currentPage = 1;
        }

        var today = TimeProvider.GetUtcNow().UtcDateTime.Date;
        var response = await TransactionsApiClient
            .GetTransactionsAsync(today, currentPage - 1, PageSize)
            .ConfigureAwait(false);

        transactions = response.Items;
        totalPages = response.TotalPages > 0 ? response.TotalPages : 1;
    }

    private Task ChangePage(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > totalPages)
        {
            return Task.CompletedTask;
        }

        currentPage = pageNumber;
        NavigationManager.NavigateTo($"lancamentos?page={pageNumber}");
        return Task.CompletedTask;
    }
}
